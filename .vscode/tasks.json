{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: server",
      "type": "shell",
      "command": "cargo build -p rvh-cli",
      "problemMatcher": "$rustc",
      "group": "build"
    },
    {
      "label": "build: extension",
      "type": "shell",
      "command": "pnpm --dir editors/vscode run build",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "build: all",
      "dependsOn": [
        "build: server",
        "build: extension"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
