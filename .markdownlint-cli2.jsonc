{
  "ignores": [
    "node_modules/**",
    "web/node_modules/**",
    "editors/vscode/node_modules/**",
    "web/dist/**",
    "editors/vscode/out/**",
    "target/**"
  ],
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "MD025": {
      "front_matter_title": ""
    },
    "MD060": false,
    "MD013": {
      "line_length": 100,
      "code_blocks": false,
      "tables": false,
      "headings": false
    }
  }
}
