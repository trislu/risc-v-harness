SourceFile
  Line
    Comment "# Declare the whole file's target with `.attribute arch`."
    NL "\n"
  Line
    Comment "# The attribute replaces the target, so it has to name every extension the file"
    NL "\n"
  Line
    Comment "# uses: dropping `zicsr` here would make the `csrr` below illegal."
    NL "\n"
  Line
    WS "    "
    Dir
      DirName ".attribute"
      WS " "
      Op
        Ident "arch"
      Comma ","
      WS " "
      Op
        String "\"rv32i2p1_m2p0_zicsr2p0\""
    NL "\n"
  Line
    WS "    "
    Dir
      DirName ".text"
    NL "\n"
  Line
    WS "    "
    Dir
      DirName ".globl"
      WS " "
      Op
        Ident "_start"
    NL "\n"
  Line
    Label
      Ident "_start"
      Colon ":"
    NL "\n"
  Line
    WS "    "
    Insn
      Ident "li"
      WS " "
      Op
        Ident "a0"
      Comma ","
      WS " "
      Op
        Number "6"
    NL "\n"
  Line
    WS "    "
    Insn
      Ident "li"
      WS " "
      Op
        Ident "a1"
      Comma ","
      WS " "
      Op
        Number "7"
    NL "\n"
  Line
    WS "    "
    Insn
      Ident "mul"
      WS " "
      Op
        Ident "a2"
      Comma ","
      WS " "
      Op
        Ident "a0"
      Comma ","
      WS " "
      Op
        Ident "a1"
    NL "\n"
  Line
    WS "    "
    Insn
      Ident "csrr"
      WS " "
      Op
        Ident "a3"
      Comma ","
      WS " "
      Op
        Ident "mstatus"
    NL "\n"
  Line
    WS "    "
    Insn
      Ident "ebreak"
    NL "\n"
---
diagnostics: none
